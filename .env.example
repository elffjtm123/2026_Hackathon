APP_ENV=development
DATABASE_URL=postgresql+asyncpg://feedback:feedback@postgres:5432/feedback
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:9000","http://127.0.0.1:5173","http://127.0.0.1:9000"]
AI_MODE=local
AI_BASE_URL=http://ai:9000
VISION_PROVIDER=uniface
FACE_LANDMARKER_PATH=.models/face_landmarker.task
STT_PROVIDER=qwen3_asr
STT_MODEL=Qwen/Qwen3-ASR-0.6B
STT_DEVICE=auto
STT_CONTEXT=
STT_SILENCE_RMS_THRESHOLD=0.003
PRONUNCIATION_PROVIDER=alignment
AUTO_CREATE_TABLES=false
VIDEO_QUEUE_SIZE=1
AUDIO_QUEUE_SIZE=32
PIPELINE_GRACE_SECONDS=30
MODULE_TIMEOUT_SECONDS=3
MAX_MEDIA_MESSAGE_BYTES=2097152
MAX_SCRIPT_CHARS=20000
SUMMARY_SERVER_PATH=.models/llama/llama-server
SUMMARY_MODEL_PATH=.models/Qwen3.5-0.8B-Q8_0.gguf
SUMMARY_TIMEOUT_SECONDS=180
MIN_TIME_LIMIT_SECONDS=30
MAX_TIME_LIMIT_SECONDS=3600
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
